# Alpaca API Credentials
# Get these from https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true  # Set to false for live trading

# LLM Provider Configuration
# Choose your preferred LLM provider: anthropic, openai
LLM_PROVIDER=anthropic

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI - https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# News API (optional) - https://newsapi.org/
NEWS_API_KEY=your_news_api_key

# Trading Configuration
MAX_POSITION_SIZE=0.1  # Max 10% of portfolio per position
MAX_DAILY_TRADES=10
RISK_LEVEL=moderate  # conservative, moderate, aggressive

# Research Configuration
RESEARCH_DEPTH=deep  # shallow, moderate, deep
CACHE_DURATION_HOURS=1

# Logging
LOG_LEVEL=INFO
